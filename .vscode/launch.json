{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32 with J-Link",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "device": "STM32H750VBT6",
            "interface": "swd",
            "executable": "${workspaceFolder}/main.elf",
            "gdbPath": "gdb-multiarch",
            "cwd": "${workspaceFolder}",
            "gdbTarget": "localhost:2331",
            "svdFile": "${workspaceFolder}/.vscode/STM32H750.svd",
            "preLaunchCommands": [
                "load",
                "break main"
            ],
        }
    ]
}